{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the FileFlow main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "updater:default",
    "process:default"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileFlow",
  "version": "1.0.10",
  "identifier": "com.fileflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run frontend:build && node scripts/release/validate-frontend-dist.mjs",
    "frontendDist": "../frontend/dist/fileflow/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileFlow",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$TEMP/**",
          "$APPDATA/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$AUDIO/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local file conversion and organisation toolbox",
    "createUpdaterArtifacts": true,
    "longDescription": "FileFlow est une boîte à outils locale de conversion, compression, organisation et automatisation de fichiers.",
    "publisher": "FileFlow"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBMThGRjhFNDI3OUVBQjQKUldTMDZubENqdjhZK3VIVHNxNEgrM2orRnczVFYxbjNHdSt4eGc5cVJwZlNHZnYyRUVBWHFKcVgK",
      "endpoints": [
        "https://github.com/idris-ach2002/FileFlow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

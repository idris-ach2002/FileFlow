/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; script-src-elem 'self'; script-src-attr 'none'; object-src 'none'; worker-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/interactions.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

/platform.js
  Cache-Control: public, max-age=31536000, immutable

/release-client.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/install.sh
  Cache-Control: no-store

/install.ps1
  Cache-Control: no-store

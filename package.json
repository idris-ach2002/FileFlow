{
  "name": "fileflow-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend:dev": "pnpm --filter @fileflow/frontend start",
    "frontend:build": "pnpm --filter @fileflow/frontend build",
    "frontend:test": "pnpm --filter @fileflow/frontend test",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "fmt": "cargo fmt --all -- --check",
    "check": "pnpm run frontend:build && pnpm run check:rust",
    "test": "pnpm run frontend:test && pnpm run test:rust",
    "engines": "sh scripts/check-engines.sh",
    "setup": "sh scripts/setup.sh",
    "build:mac": "tauri build --bundles app,dmg",
    "build:mac:universal": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:linux": "tauri build --bundles deb,appimage",
    "verify": "sh scripts/verify.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26"
  },
  "packageManager": "pnpm@11.20.0"
}
